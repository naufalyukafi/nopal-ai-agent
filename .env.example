# Nopal Agent Environment Variables Template

# Data Encryption Key (Must be 32+ characters hex or random string)
ENCRYPTION_SECRET=your_32_byte_data_encryption_secret_key

# Supabase Credentials
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Engine Model (gemini-3.5-flash-lite or gemini-3.6-flash)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram Bot Token & Webhook Verification Secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_SECRET_TOKEN=your_telegram_secret_token

# Gmail OAuth 2.0 Credentials
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/gmail-sync/callback
